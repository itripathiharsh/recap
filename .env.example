# .env.example
# Copy this file to .env and fill in real values using SETUP.md as your guide.
# Never commit the real .env file — it's already in .gitignore.

# --- Bot's dedicated Google account (SETUP.md Section 2) ---
GOOGLE_BOT_EMAIL=your-bot-account@gmail.com
GOOGLE_BOT_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Google Cloud OAuth credentials for Calendar + Gmail, acting on the OWNER's account (SETUP.md Section 3) ---
CALENDAR_API_CREDENTIALS_PATH=./credentials/calendar_credentials.json
GMAIL_API_CREDENTIALS_PATH=./credentials/gmail_credentials.json

# --- Hugging Face token for downloading the pyannote diarization model (SETUP.md Section 4) ---
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- LLM & STT API keys (with dual-key failover) ---
GROQ_API_KEY=gsk_your_primary_groq_key_here
GROQ_API_KEY_2=gsk_your_secondary_groq_key_here
GEMINI_API_KEY=your_primary_gemini_key_here
GEMINI_API_KEY_2=your_secondary_gemini_key_here
STT_PROVIDER=gemini  # Options: gemini (recommended), groq, local

# --- Where the MOM gets delivered ---
OWNER_NAME="Your Name"
OWNER_EMAIL=you@example.com

# --- Recording / model config (SPEC.md Section 4) ---
MAX_RECORDING_MINUTES=90
WHISPER_MODEL_SIZE=small
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.5-flash

# --- Optional: override polling interval for scheduler.py, in minutes (SPEC.md Section 4.5) ---
CALENDAR_POLL_INTERVAL_MINUTES=3

# --- Supabase Database & Auth (Phase 2 & 4) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key
# Backend writes require the SERVICE ROLE key once RLS migrations are applied.
# Keep this secret — it must never reach the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Owner for legacy meetings during workspace backfill (scripts/backfill_meeting_ownership.py)
# and as the default owner for meetings created via the backend API.
MEETINGS_OWNER_EMAIL=you@example.com
RETENTION_DAYS=7

# --- FastAPI access control ---
# Shared secret for non-loopback callers of the FastAPI server (sent as the
# X-Internal-Token header). Loopback callers (worker, OAuth, local curl) are
# always allowed. While unset, remote access stays open (legacy behaviour)
# and a warning is logged at startup.
FASTAPI_AUTH_TOKEN=
# Comma-separated origins allowed by CORS (default "*").
DASHBOARD_ORIGIN=*

# --- Google Meet REST API OAuth (Web Application) ---
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_MEET_TOKEN_PATH=credentials/google_meet_token.json

# --- Browser Visibility (1 = show on desktop, 0 = silent background Xvfb) ---
SHOW_BROWSER=1

