[Unit]
Description=Meeting Recorder FastAPI Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/meet-recorder
EnvironmentFile=/home/ubuntu/meet-recorder/.env
ExecStart=/home/ubuntu/meet-recorder/.venv/bin/uvicorn src.api:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
