[Unit]
Description=Recap Meeting Recorder Worker Daemon
After=network.target sound.target xvfb.service
Wants=xvfb.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/meet-recorder
EnvironmentFile=/home/ubuntu/meet-recorder/.env
Environment="PULSE_SERVER=unix:/mnt/wslg/PulseServer"
Environment="DISPLAY=:99"
Environment="PLAYWRIGHT_BROWSERS_PATH=/home/ubuntu/meet-recorder/.temp/ms-playwright"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/ubuntu/meet-recorder/.venv/bin/python3 -m src.scheduler
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
